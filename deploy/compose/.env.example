# Copy to .env (next to compose.yaml) and fill in. Secrets do not go here: they are files in
# secrets/ (see the top of compose.yaml).

# Public host name of the server. Its DNS A/AAAA records point to this machine; Caddy gets the
# certificate for it, and the MCP endpoint is https://<SEVDESK_DOMAIN>/mcp.
SEVDESK_DOMAIN=mcp.example.com

# sevDesk account ids that may connect, comma-separated. With SEVDESK_API_TOKEN set in your shell,
# this prints the id of the token's account:
#   docker run --rm -e SEVDESK_API_TOKEN ghcr.io/jaylann/mcp-server-sevdesk:latest account-id
SEVDESK_OAUTH_ACCOUNTS=

# Highest permission tiers a connection may be granted (read, write, commit, external, or all).
# Each OAuth grant picks its tiers on the consent page, up to this cap.
SEVDESK_ALLOW=read
