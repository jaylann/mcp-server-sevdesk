// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prompts/list > SEVDESK_ALLOW=all with all toolsets 1`] = `
[
  {
    "arguments": [
      {
        "description": "Payment account reference (name or id, up to 200 characters). Default: no account scope.",
        "name": "checkAccount",
        "required": false,
      },
      {
        "description": "Month to reconcile, YYYY-MM (2000–2099). Default: no date scope.",
        "name": "month",
        "required": false,
      },
    ],
    "description": "Match unbooked bank transactions in sevDesk to invoices, credit notes and receipts: suggestions with reasons, then each booking the user confirms with a dry run first; private withdrawals and deposits, costs without a receipt and wrong bookings. Not tax advice.",
    "name": "bank_reconciliation",
    "title": "Bank reconciliation (Kontoabgleich)",
  },
  {
    "arguments": [
      {
        "description": "Customer reference (name or id, up to 200 characters). Default: all customers.",
        "name": "contact",
        "required": false,
      },
      {
        "description": "Minimum days overdue (inclusive, 0–3650, as 1–4 digits). Default: all overdue invoices.",
        "name": "minDaysOverdue",
        "required": false,
      },
    ],
    "description": "Find overdue invoices in sevDesk, rule out payments that are not booked yet, and prepare payment reminders (Mahnungen) for the ones the user picks, with a dry run first. Without the write tier it only lists the overdue invoices. Not tax advice.",
    "name": "dunning_run",
    "title": "Dunning run (Mahnlauf)",
  },
  {
    "arguments": [
      {
        "description": "Month (YYYY-MM, e.g. 2026-10) or quarter (YYYY-Qn, e.g. 2026-Q3). Default: the previous month.",
        "name": "period",
        "required": false,
      },
      {
        "description": "Payment account reference (name or id, up to 200 characters). Default: all payment accounts.",
        "name": "checkAccount",
        "required": false,
      },
    ],
    "description": "Find missing receipts in sevDesk for a month or quarter: outgoing bank transactions no voucher explains, regular suppliers without a bill, receipts only on drafts or booked twice and, where the server reads a receipt folder, files never booked; then file the ones found as voucher drafts, with a dry run first. Findings are hints. Not tax advice.",
    "name": "missing_receipts",
    "title": "Missing receipts (fehlende Belege)",
  },
  {
    "arguments": [
      {
        "description": "Month to close, YYYY-MM (e.g. 2026-10). Default: the previous month.",
        "name": "month",
        "required": false,
      },
    ],
    "description": "Close a month in sevDesk: what changed, unbooked bank transactions and missing receipts, drafts, double bookings and missing bills, overdue invoices, payables and liquidity, the VAT pre-check, profit and the hand-over to the Steuerberater. Steps the configuration does not allow are named, not worked around. Not tax advice.",
    "name": "month_end_close",
    "title": "Month-end close (Monatsabschluss)",
  },
  {
    "arguments": [
      {
        "description": "Only offers at least this many days old, from the offer date (inclusive, 0–3650, as 1–4 digits). Default: 14.",
        "name": "minAgeDays",
        "required": false,
      },
      {
        "description": "Customer reference (name or id, up to 200 characters). Default: all customers.",
        "name": "contact",
        "required": false,
      },
    ],
    "description": "Follow up on open offers (Angebote) in sevDesk: sent offers the customer has not answered after some days, then per offer marking it accepted or rejected, the order confirmation, delivery note and invoice from it, each with a dry run first, or a follow-up message the user sends. Not tax advice.",
    "name": "offer_follow_up",
    "title": "Offer follow-up (Angebote nachfassen)",
  },
  {
    "arguments": [
      {
        "description": "The receipt or e-invoice file, as the voucher tools take it (a path inside SEVDESK_FILE_DIRS, an upload reference, or an https link to a host in SEVDESK_FILE_URL_HOSTS). Default: the assistant asks for it.",
        "name": "file",
        "required": false,
      },
    ],
    "description": "File a receipt or supplier invoice in sevDesk, or import an e-invoice (E-Rechnung: XRechnung, ZUGFeRD): duplicate check, booking account and tax rule, the voucher draft with a dry run first, then finalizing and the payment. Not tax advice.",
    "name": "receipt_intake",
    "title": "File a receipt (Beleg erfassen)",
  },
  {
    "arguments": [
      {
        "description": "Month (YYYY-MM, e.g. 2026-10) or quarter (YYYY-Qn, e.g. 2026-Q3). Default: the previous month.",
        "name": "period",
        "required": false,
      },
    ],
    "description": "Check a month or quarter in sevDesk before the Umsatzsteuer-Voranmeldung (UStVA): unbooked transactions and drafts, the VAT summary with its Kennzahlen, audits of the VAT treatment, the § 13b base and double bookings, spot checks and the Zusammenfassende Meldung. The server does not file anything. Not tax advice.",
    "name": "vat_precheck",
    "title": "VAT pre-check (UStVA-Vorprüfung)",
  },
  {
    "arguments": [
      {
        "description": "Year to hand over, YYYY (2000–2099, e.g. 2025). Default: the previous year.",
        "name": "year",
        "required": false,
      },
    ],
    "description": "Prepare a year in sevDesk for the Steuerberater: unbooked transactions and drafts, profit and loss (EÜR view), the audits, open invoices and vouchers, the DATEV export (CSV or XML; the DATEV settings only if they are missing or wrong) and the invoice and receipt archive in parts, each export with a dry run first. Findings are hints. Not tax advice.",
    "name": "year_end_handoff",
    "title": "Year-end handoff (Übergabe an den Steuerberater)",
  },
]
`;

