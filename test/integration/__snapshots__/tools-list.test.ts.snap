          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxText": {
          "description": "Tax note printed on the document; default: the tax rule's German name.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "timeToPay": {
          "description": "Zahlungsziel in days, e.g. 14.",
          "maximum": 3650,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_invoice_update_draft",
    "title": "Update a draft invoice",
  },
