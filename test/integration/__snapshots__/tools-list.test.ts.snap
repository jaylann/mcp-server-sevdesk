    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allowDuplicate": {
          "default": false,
          "description": "Create the contact even though one with the same name or e-mail exists. Only after checking that the existing one is really someone else.",
          "type": "boolean",
        },
        "buyerReference": {
          "description": "Leitweg-ID / buyer reference for e-invoices (XRechnung) to public bodies.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "category": {
          "default": "customer",
          "description": "customer (Kunde), supplier (Lieferant), partner or prospect (Interessent).",
          "enum": [
            "supplier",
            "customer",
            "partner",
            "prospect",
          ],
          "type": "string",
        },
        "city": {
          "description": "City (Ort).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "country": {
          "description": "Country as ISO 3166-1 alpha-2 code, e.g. DE (default for a new address), AT, CH.",
          "pattern": "^[A-Za-z]{2}$",
          "type": "string",
        },
        "customerNumber": {
          "description": "Kundennummer; must not be used yet.",
          "maxLength": 50,
          "minLength": 1,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "email": {
          "description": "E-mail address.",
