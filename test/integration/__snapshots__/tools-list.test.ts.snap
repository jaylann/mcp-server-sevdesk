    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "description": "Changed records to return per subject, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "sevDesk rows to skip (a previous nextOffset); only with exactly one subject.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "since": {
          "description": "Start: YYYY-MM-DD (00:00 Berlin) or an ISO 8601 date-time, e.g. 2026-11-01T08:00:00+01:00 (Berlin time without an offset).",
          "maxLength": 40,
          "minLength": 10,
          "type": "string",
