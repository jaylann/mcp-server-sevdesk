                "description": "Rabatt on this position in percent, more than 0 and at most 100.",
                "type": [
                  "string",
                  "number",
                ],
              },
              "name": {
                "description": "Article or service name (Bezeichnung) as printed.",
                "maxLength": 250,
                "minLength": 1,
                "type": "string",
              },
              "optional": {
                "description": "Optional position (Optionale Position, offers): printed, not part of the total.",
                "type": "boolean",
              },
              "partId": {
                "description": "Inventory part (Artikel, see sevdesk_parts_list) to link. Name and price still come from this position; sevDesk does not fill them in.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "quantity": {
                "description": "Menge, greater than 0, up to 4 decimals, e.g. 2 or "1.5".",
                "type": [
                  "string",
                  "number",
                ],
              },
              "taxRate": {
                "description": "Umsatzsteuersatz in percent, e.g. 19, 7 or 0; must be allowed by the tax rule. May be left out only when the rule allows a single rate (e.g. 0 for rule 11).",
                "type": [
                  "string",
                  "number",
                ],
              },
              "text": {
                "description": "Description printed below the name (Positionstext); line breaks allowed.",
                "maxLength": 5000,
                "type": "string",
              },
              "unitId": {
                "description": "Einheit (Unity id, see sevdesk_reference_lookup kind=units); default 1 = Stk.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "unitPrice": {
                "description": "Einzelpreis per unit in the document currency, net or gross as the document's priceMode says; up to 4 decimals, e.g. "49.90"; negative for a deduction line.",
                "type": [
                  "string",
                  "number",
                ],
              },
            },
            "required": [
              "name",
              "quantity",
              "unitPrice",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "priceMode": {
          "description": "Whether position unit prices are net (netto, the default for new drafts) or gross (brutto). Sets sevDesk's showNet.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "taxRule": {
          "description": "Tax rule (Steuerregel) id: 1 taxable domestic revenue (default), 2 exports, 3 intra-EU supplies, 4 tax-exempt §4, 5 reverse charge §13b, 11 Kleinunternehmer §19, 17 not taxable in Germany, 18–20 One-Stop-Shop, 21 reverse charge for EU services. Details: sevdesk_reference_lookup kind=tax_rules.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxText": {
          "description": "Tax note printed on the document; default: the tax rule's German name.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "contactId",
        "orderType",
        "positions",
      ],
      "type": "object",
    },
