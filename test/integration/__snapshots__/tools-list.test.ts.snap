              "linked",
              "private",
              "auto_booked",
              "booked",
            ],
            "type": "string",
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
      },
      "type": "object",
    },
