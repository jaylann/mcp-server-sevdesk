          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "id": {
          "description": "Order id (not the order number), e.g. from sevdesk_orders_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "sendCopyToMe": {
          "description": "Also send a copy to the sevDesk user's own address. Defaults to false.",
          "type": "boolean",
        },
        "subject": {
          "description": "Subject (Betreff), one line.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "text": {
          "description": "Email text; simple HTML allowed. sevDesk attaches the document itself.",
          "maxLength": 10000,
          "minLength": 1,
          "type": "string",
        },
        "to": {
          "description": "Recipient (Empfänger): one email address.",
          "type": "string",
        },
      },
      "required": [
        "id",
        "to",
        "subject",
        "text",
      ],
      "type": "object",
    },
    "name": "sevdesk_order_send_email",
    "title": "Email a sevDesk order",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create an invoice from a sevDesk order",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allowDuplicate": {
          "default": false,
          "description": "Create it even though an invoice draft from this order exists.",
          "type": "boolean",
        },
        "amount": {
          "description": "partial/advance only: the amount, in the unit of amountType.",
          "type": [
            "string",
            "number",
          ],
        },
        "amountType": {
          "default": "percentage",
          "description": "partial/advance only: percent of the order, or an amount net or gross.",
          "enum": [
            "percentage",
            "net",
            "gross",
          ],
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "mode": {
          "default": "full",
          "description": "full: whole order; partial: Teilrechnung; advance: Abschlagsrechnung.",
          "enum": [
            "full",
            "partial",
            "advance",
          ],
          "type": "string",
        },
        "orderId": {
          "description": "Order id (not its number), e.g. from sevdesk_orders_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "orderId",
      ],
      "type": "object",
    },
    "name": "sevdesk_order_to_invoice",
    "title": "Create an invoice from a sevDesk order",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update a draft order",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "addressCity": {
          "description": "City (Ort).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "addressCountry": {
          "description": "ISO 3166-1 alpha-2 country code of the address, e.g. DE, AT, CH; default: the country of the address it changes, else DE.",
          "pattern": "^[A-Za-z]{2}$",
          "type": "string",
        },
        "addressName": {
          "description": "Recipient name as printed. Address fields replace the matching parts of the contact's invoice address (new drafts) or of the stored address (updates); the rest is kept.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressStreet": {
          "description": "Street and number.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressZip": {
          "description": "Postcode (PLZ).",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "contactId": {
          "description": "Customer contact id (Kontakt), from sevdesk_contacts_search.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "contactPersonId": {
          "description": "sevDesk user (SevUser) shown as contact person (Ansprechpartner). Required only when the account has several users: sevdesk_reference_lookup kind=users lists them.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "currency": {
          "description": "ISO 4217 currency code (Währung); default EUR.",
          "pattern": "^[A-Za-z]{3}$",
          "type": "string",
        },
        "date": {
          "description": "Angebots-/Auftragsdatum, YYYY-MM-DD.",
          "type": "string",
        },
        "deliveryTerms": {
          "description": "Lieferbedingungen as printed on the document.",
          "maxLength": 5000,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "footText": {
          "description": "Closing text below the positions (Fußtext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "headText": {
          "description": "Intro text above the positions (Kopftext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "header": {
          "description": "Document title (Betreff).",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "id": {
          "description": "Id of the draft order (not its number), e.g. from sevdesk_orders_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "paymentTerms": {
          "description": "Zahlungsbedingungen as printed on the document.",
          "maxLength": 5000,
          "type": "string",
        },
        "positions": {
          "description": "When given, replaces ALL positions; leave out to keep them.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "discountPercent": {
                "description": "Rabatt on this position in percent, more than 0 and at most 100.",
                "type": [
                  "string",
                  "number",
                ],
              },
              "name": {
                "description": "Article or service name (Bezeichnung) as printed.",
                "maxLength": 250,
                "minLength": 1,
                "type": "string",
              },
              "optional": {
                "description": "Optional position (Optionale Position, offers): printed, not part of the total.",
                "type": "boolean",
              },
              "partId": {
                "description": "Inventory part (Artikel, see sevdesk_parts_list) to link. Name and price still come from this position; sevDesk does not fill them in.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "quantity": {
                "description": "Menge, greater than 0, up to 4 decimals, e.g. 2 or "1.5".",
                "type": [
                  "string",
                  "number",
                ],
              },
              "taxRate": {
                "description": "Umsatzsteuersatz in percent, e.g. 19, 7 or 0; must be allowed by the tax rule. May be left out only when the rule allows a single rate (e.g. 0 for rule 11).",
                "type": [
                  "string",
                  "number",
                ],
              },
              "text": {
                "description": "Description printed below the name (Positionstext); line breaks allowed.",
                "maxLength": 5000,
                "type": "string",
              },
              "unitId": {
                "description": "Einheit (Unity id, see sevdesk_reference_lookup kind=units); default 1 = Stk.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "unitPrice": {
                "description": "Einzelpreis per unit in the document currency, net or gross as the document's priceMode says; up to 4 decimals, e.g. "49.90"; negative for a deduction line.",
                "type": [
                  "string",
                  "number",
                ],
              },
            },
            "required": [
              "name",
              "quantity",
              "unitPrice",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "priceMode": {
          "description": "Net or gross unit prices (showNet). Changing it requires positions too.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "taxRule": {
          "description": "New tax rule (Steuerregel) id; see sevdesk_reference_lookup kind=tax_rules.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxText": {
          "description": "Tax note printed on the document; default: the tax rule's German name.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_order_update_draft",
    "title": "Update a draft order",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List sevDesk orders",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "contactId": {
          "description": "Only orders of this contact.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "from": {
          "description": "First day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "number": {
          "description": "Exact order number, e.g. 'AN-1000'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "status": {
          "description": "draft 100, sent 200, rejected 300, accepted 500, partially_invoiced 750, invoiced 1000.",
          "enum": [
            "draft",
            "sent",
            "rejected",
            "accepted",
            "partially_invoiced",
            "invoiced",
          ],
          "type": "string",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "type": {
          "description": "offer (AN), order_confirmation (AB) or delivery_note (LI).",
          "enum": [
            "offer",
            "order_confirmation",
            "delivery_note",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_orders_list",
    "title": "List sevDesk orders",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a sevDesk part",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Description (Beschreibung) printed on documents.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "internalComment": {
          "description": "Internal note, not printed.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "name": {
          "description": "Part name (Artikelname) as printed on documents.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "partNumber": {
          "description": "Artikelnummer; must not be used by another part.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "price": {
          "description": "Sales price (Verkaufspreis) in EUR, net or gross per priceType; the other one is computed with the tax rate.",
          "type": [
            "string",
            "number",
          ],
        },
        "pricePurchase": {
          "description": "Purchase price (Einkaufspreis), net, EUR.",
          "type": [
            "string",
            "number",
          ],
        },
        "priceType": {
          "default": "net",
          "description": "Whether price is the net (netto, default) or gross (brutto) price.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "stock": {
          "description": "Stock (Bestand).",
          "type": [
            "string",
            "number",
          ],
        },
        "stockEnabled": {
          "default": false,
          "description": "Track stock (Lagerbestand) for the part.",
          "type": "boolean",
        },
        "taxRate": {
          "description": "Tax rate in percent, default 19.",
          "type": [
            "string",
            "number",
          ],
        },
        "unitId": {
          "default": 1,
          "description": "Unit (Einheit) id, see sevdesk_reference_lookup kind=units (1 = Stk).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "name",
        "partNumber",
      ],
      "type": "object",
    },
    "name": "sevdesk_part_create",
    "title": "Create a sevDesk part",
  },
