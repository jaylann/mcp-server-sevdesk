        },
      },
      "type": "object",
    },
    "name": "sevdesk_cash_position",
    "title": "Cash position",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
