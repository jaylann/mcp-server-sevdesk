            "open",
            "transferred",
            "partially_paid",
            "paid",
          ],
          "type": "string",
        },
        "supplierId": {
          "description": "Contact id of the supplier (Lieferant) or customer.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "supplierName": {
