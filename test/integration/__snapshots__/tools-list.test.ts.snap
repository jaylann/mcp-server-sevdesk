exports[`tools/list > SEVDESK_ALLOW=all with all toolsets 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "sevDesk account overview",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "sevdesk_account_info",
    "title": "sevDesk account overview",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get a sevDesk contact",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Contact id, e.g. from sevdesk_contacts_search.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_contact_get",
    "title": "Get a sevDesk contact",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Next free sevDesk customer number",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "sevdesk_contacts_next_customer_number",
    "title": "Next free sevDesk customer number",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Search sevDesk contacts",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "customer (Kunde), supplier (Lieferant), partner or prospect (Interessent).",
          "enum": [
            "supplier",
            "customer",
            "partner",
            "prospect",
          ],
          "type": "string",
        },
        "customerNumber": {
          "description": "Exact customer number (Kundennummer), e.g. 'K-1001'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Matches to skip, for paging.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "query": {
          "description": "Name or part of a name, e.g. 'Musterfirma' or 'Mustermann'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_contacts_search",
    "title": "Search sevDesk contacts",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Look up sevDesk ids and codes",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Which list to return.",
          "enum": [
            "tax_rules",
            "contact_categories",
            "status_codes",
            "document_types",
            "users",
            "countries",
            "units",
            "payment_methods",
          ],
          "type": "string",
        },
        "query": {
          "description": "Case-insensitive substring filter on names, codes and ids, e.g. 'reverse'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "kind",
      ],
      "type": "object",
    },
    "name": "sevdesk_reference_lookup",
    "title": "Look up sevDesk ids and codes",
  },
]
`;

