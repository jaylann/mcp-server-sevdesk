        },
        "header": {
          "description": "Document title (Betreff); default "Angebot", "Auftragsbestätigung" or "Lieferschein".",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "orderType": {
          "description": "offer (Angebot, AN), order_confirmation (Auftragsbestätigung, AB) or delivery_note (Lieferschein, LI).",
          "enum": [
            "offer",
            "order_confirmation",
            "delivery_note",
          ],
          "type": "string",
        },
        "paymentTerms": {
          "description": "Zahlungsbedingungen as printed on the document.",
          "maxLength": 5000,
          "type": "string",
        },
        "positions": {
          "description": "Positionen in printed order; prices per priceMode.",
