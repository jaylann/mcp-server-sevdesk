exports[`tools/list > SEVDESK_OUTPUT_DIR set (adds the file-writing save tool) 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Save a document file to disk",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "document": {
          "description": "Which file: invoice_pdf, credit_note_pdf, order_pdf, or invoice_xml (e-invoice XML).",
          "enum": [
            "invoice_pdf",
            "credit_note_pdf",
            "order_pdf",
            "invoice_xml",
          ],
          "type": "string",
        },
        "id": {
          "description": "sevDesk id of the document (not its number such as RE-1001).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "document",
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_document_save",
    "title": "Save a document file to disk",
  },
]
`;

