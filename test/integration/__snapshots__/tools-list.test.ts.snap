  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Book a payment on a sevDesk credit note",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Amount paid out, gross, positive, in the credit note's currency, e.g. "119.00" (at most 2 decimals).",
          "type": [
            "string",
            "number",
          ],
        },
        "checkAccountId": {
          "description": "Check account (Zahlungskonto) the money moved on, from sevdesk_bank_accounts_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "date": {
          "description": "Booking date (Zahlungsdatum), YYYY-MM-DD; defaults to today (Berlin).",
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "id": {
          "description": "Credit note id (not the credit note number), e.g. from sevdesk_credit_notes_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "paymentType": {
          "description": "payment (default): all of the open amount or a part of it. cash_discount: less than the open amount, the rest is written off as Skonto. bank_fees: less, the rest written off as bank fees (Geldverkehrskosten). other_difference: more or less than the open amount for another reason; the document is settled.",
          "enum": [
            "payment",
            "cash_discount",
            "bank_fees",
            "other_difference",
          ],
          "type": "string",
        },
        "transactionId": {
          "description": "Imported bank transaction (Umsatz) to link, from sevdesk_transactions_list (status created, same account). Without it sevDesk creates a new transaction (offline and cash accounts only).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
        "amount",
        "checkAccountId",
      ],
      "type": "object",
    },
    "name": "sevdesk_credit_note_book_payment",
    "title": "Book a payment on a sevDesk credit note",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a draft credit note",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "addressCity": {
          "description": "City (Ort).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "addressCountry": {
          "description": "ISO 3166-1 alpha-2 country code of the address, e.g. DE, AT, CH; default: the country of the address it changes, else DE.",
          "pattern": "^[A-Za-z]{2}$",
          "type": "string",
        },
        "addressName": {
          "description": "Recipient name as printed. Address fields replace the matching parts of the contact's invoice address (new drafts) or of the stored address (updates); the rest is kept.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressStreet": {
          "description": "Street and number.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressZip": {
          "description": "Postcode (PLZ).",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "allowDuplicate": {
          "description": "underachievement only: create it even though a credit note for the source invoice exists (e.g. a second partial refund). Default false.",
          "type": "boolean",
        },
        "bookingCategory": {
          "description": "Buchungskategorie: underachievement (Minderleistung: reduces an issued invoice, needs sourceInvoiceId), provision (Provisionsgutschrift, tax rule 9), royalty_assigned or royalty_unassigned (Lizenzgebühren).",
          "enum": [
            "underachievement",
            "provision",
            "royalty_assigned",
            "royalty_unassigned",
          ],
          "type": "string",
        },
        "contactId": {
          "description": "Customer contact id (Kontakt), from sevdesk_contacts_search.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "contactPersonId": {
          "description": "sevDesk user (SevUser) shown as contact person (Ansprechpartner). Required only when the account has several users: sevdesk_reference_lookup kind=users lists them.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "currency": {
          "description": "ISO 4217 code; default EUR or the source invoice's currency.",
          "pattern": "^[A-Za-z]{3}$",
          "type": "string",
        },
        "date": {
          "description": "Gutschriftsdatum, YYYY-MM-DD; default today (Europe/Berlin).",
          "type": "string",
        },
        "deliveryDate": {
          "description": "Delivery or service date (Liefer-/Leistungsdatum), YYYY-MM-DD; default the document date.",
          "type": "string",
        },
        "deliveryDateUntil": {
          "description": "End of the delivery period (Leistungszeitraum bis), YYYY-MM-DD.",
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "footText": {
          "description": "Closing text below the positions (Fußtext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "headText": {
          "description": "Intro text above the positions (Kopftext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "header": {
          "description": "Document title (Betreff); default "Gutschrift".",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "positions": {
          "description": "Positionen in printed order; prices per priceMode.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "discountPercent": {
                "description": "Rabatt on this position in percent, more than 0 and at most 100.",
                "type": [
                  "string",
                  "number",
                ],
              },
              "name": {
                "description": "Article or service name (Bezeichnung) as printed.",
                "maxLength": 250,
                "minLength": 1,
                "type": "string",
              },
              "partId": {
                "description": "Inventory part (Artikel, see sevdesk_parts_list) to link. Name and price still come from this position; sevDesk does not fill them in.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "quantity": {
                "description": "Menge, greater than 0, up to 4 decimals, e.g. 2 or "1.5".",
                "type": [
                  "string",
                  "number",
                ],
              },
              "taxRate": {
                "description": "Umsatzsteuersatz in percent, e.g. 19, 7 or 0; must be allowed by the tax rule. May be left out only when the rule allows a single rate (e.g. 0 for rule 11).",
                "type": [
                  "string",
                  "number",
                ],
              },
              "text": {
                "description": "Description printed below the name (Positionstext); line breaks allowed.",
                "maxLength": 5000,
                "type": "string",
              },
              "unitId": {
                "description": "Einheit (Unity id, see sevdesk_reference_lookup kind=units); default 1 = Stk.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "unitPrice": {
                "description": "Einzelpreis per unit in the document currency, net or gross as the document's priceMode says; up to 4 decimals, e.g. "49.90"; negative for a deduction line.",
                "type": [
                  "string",
                  "number",
                ],
              },
            },
            "required": [
              "name",
              "quantity",
              "unitPrice",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "priceMode": {
          "description": "Whether position unit prices are net (netto, the default for new drafts) or gross (brutto). Sets sevDesk's showNet.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "sourceInvoiceId": {
          "description": "underachievement only: id of the finalized invoice this credit note reduces (refSrcInvoice).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxRule": {
          "description": "Tax rule (Steuerregel) id. Default: the source invoice's rule (underachievement), 9 (provision; 10 on a Kleinunternehmer account) or the account's: 1 for regular VAT, 11 for Kleinunternehmer. See sevdesk_reference_lookup kind=tax_rules.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxText": {
          "description": "Tax note printed on the document; default: the tax rule's German name.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "contactId",
        "bookingCategory",
