    "title": "List sevDesk invoices",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a draft order",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "addressCity": {
          "description": "City (Ort).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "addressCountry": {
          "description": "ISO 3166-1 alpha-2 country code of the address, e.g. DE, AT, CH; default: the country of the address it changes, else DE.",
          "pattern": "^[A-Za-z]{2}$",
          "type": "string",
        },
        "addressName": {
          "description": "Recipient name as printed. Address fields replace the matching parts of the contact's invoice address (new drafts) or of the stored address (updates); the rest is kept.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressStreet": {
          "description": "Street and number.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "addressZip": {
          "description": "Postcode (PLZ).",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
        "contactId": {
          "description": "Customer contact id (Kontakt), from sevdesk_contacts_search.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "contactPersonId": {
          "description": "sevDesk user (SevUser) shown as contact person (Ansprechpartner). Required only when the account has several users: sevdesk_reference_lookup kind=users lists them.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "currency": {
          "description": "ISO 4217 currency code (Währung); default EUR.",
          "pattern": "^[A-Za-z]{3}$",
          "type": "string",
        },
        "date": {
          "description": "Angebots-/Auftragsdatum, YYYY-MM-DD; default today (Berlin).",
          "type": "string",
        },
        "deliveryTerms": {
          "description": "Lieferbedingungen as printed on the document.",
          "maxLength": 5000,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "footText": {
          "description": "Closing text below the positions (Fußtext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "headText": {
          "description": "Intro text above the positions (Kopftext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "header": {
          "description": "Document title (Betreff); default "Angebot", "Auftragsbestätigung" or "Lieferschein".",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "orderType": {
          "description": "offer (Angebot, AN), order_confirmation (Auftragsbestätigung, AB) or delivery_note (Lieferschein, LI).",
          "enum": [
            "offer",
            "order_confirmation",
            "delivery_note",
          ],
          "type": "string",
        },
        "paymentTerms": {
          "description": "Zahlungsbedingungen as printed on the document.",
          "maxLength": 5000,
          "type": "string",
        },
        "positions": {
          "description": "Positionen in printed order; prices per priceMode.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "discountPercent": {
                "description": "Rabatt on this position in percent, more than 0 and at most 100.",
                "type": [
                  "string",
                  "number",
                ],
              },
              "name": {
                "description": "Article or service name (Bezeichnung) as printed.",
                "maxLength": 250,
                "minLength": 1,
                "type": "string",
              },
              "optional": {
                "description": "Optional position (Optionale Position, offers): printed, not part of the total.",
                "type": "boolean",
              },
              "partId": {
                "description": "Inventory part (Artikel, see sevdesk_parts_list) to link. Name and price still come from this position; sevDesk does not fill them in.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "quantity": {
                "description": "Menge, greater than 0, up to 4 decimals, e.g. 2 or "1.5".",
                "type": [
                  "string",
                  "number",
                ],
              },
              "taxRate": {
                "description": "Umsatzsteuersatz in percent, e.g. 19, 7 or 0; must be allowed by the tax rule. May be left out only when the rule allows a single rate (e.g. 0 for rule 11).",
                "type": [
                  "string",
                  "number",
                ],
              },
              "text": {
                "description": "Description printed below the name (Positionstext); line breaks allowed.",
                "maxLength": 5000,
                "type": "string",
              },
              "unitId": {
                "description": "Einheit (Unity id, see sevdesk_reference_lookup kind=units); default 1 = Stk.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "unitPrice": {
                "description": "Einzelpreis per unit in the document currency, net or gross as the document's priceMode says; up to 4 decimals, e.g. "49.90"; negative for a deduction line.",
                "type": [
                  "string",
                  "number",
                ],
              },
            },
            "required": [
              "name",
              "quantity",
              "unitPrice",
            ],
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "priceMode": {
          "description": "Whether position unit prices are net (netto, the default for new drafts) or gross (brutto). Sets sevDesk's showNet.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "taxRule": {
          "description": "Tax rule (Steuerregel) id: 1 taxable domestic revenue (default), 2 exports, 3 intra-EU supplies, 4 tax-exempt §4, 5 reverse charge §13b, 11 Kleinunternehmer §19, 17 not taxable in Germany, 18–20 One-Stop-Shop, 21 reverse charge for EU services. Details: sevdesk_reference_lookup kind=tax_rules.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "taxText": {
          "description": "Tax note printed on the document; default: the tax rule's German name.",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "contactId",
        "orderType",
        "positions",
      ],
      "type": "object",
    },
    "name": "sevdesk_order_create_draft",
    "title": "Create a draft order",
  },
