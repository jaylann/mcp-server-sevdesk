  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a sevDesk contact",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allowDuplicate": {
          "default": false,
          "description": "Create the contact even though one with the same name or e-mail exists. Only after checking that the existing one is really someone else.",
          "type": "boolean",
        },
        "buyerReference": {
          "description": "Leitweg-ID / buyer reference for e-invoices (XRechnung) to public bodies.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "category": {
          "default": "customer",
          "description": "customer (Kunde), supplier (Lieferant), partner or prospect (Interessent).",
          "enum": [
            "supplier",
            "customer",
            "partner",
            "prospect",
          ],
          "type": "string",
        },
        "city": {
          "description": "City (Ort).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "country": {
          "description": "Country as ISO 3166-1 alpha-2 code, e.g. DE (default for a new address), AT, CH.",
          "pattern": "^[A-Za-z]{2}$",
          "type": "string",
        },
        "customerNumber": {
          "description": "Kundennummer; must not be used yet.",
          "maxLength": 50,
          "minLength": 1,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "email": {
          "description": "E-mail address.",
          "format": "email",
          "maxLength": 254,
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "firstName": {
          "description": "Person: first name (sevDesk field surename). Leave organisationName out.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "lastName": {
          "description": "Person: last name (sevDesk field familyname).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "organisationName": {
          "description": "Organisation (company) name. Leave firstName/lastName out for organisations.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "phone": {
          "description": "Phone number (Telefon).",
          "maxLength": 50,
          "minLength": 3,
          "pattern": "^[0-9+()/.\\- ]+$",
          "type": "string",
        },
        "street": {
          "description": "Street and house number (Straße).",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "taxNumber": {
          "description": "Steuernummer (tax number).",
          "maxLength": 30,
          "minLength": 1,
          "type": "string",
        },
        "vatNumber": {
          "description": "USt-IdNr. (VAT ID), e.g. DE123456789.",
          "type": "string",
        },
        "website": {
          "description": "Website, e.g. https://example.com.",
          "maxLength": 255,
          "pattern": "^(https?:\\/\\/)?[^\\s/.]+(\\.[^\\s/.]+)+(\\/\\S*)?$",
          "type": "string",
        },
        "zip": {
          "description": "Postal code (PLZ).",
          "maxLength": 20,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_contact_create",
    "title": "Create a sevDesk contact",
  },
