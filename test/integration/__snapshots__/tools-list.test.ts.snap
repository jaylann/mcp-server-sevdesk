        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "number": {
          "description": "Exact credit note number, e.g. 'GU-1000'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "status": {
          "description": "draft (100), open (200), partially_paid (750) or paid (1000).",
          "enum": [
            "draft",
            "open",
            "partially_paid",
            "paid",
          ],
          "type": "string",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
      },
      "type": "object",
