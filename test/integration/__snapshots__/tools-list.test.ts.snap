  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List sevDesk invoices",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "contactId": {
          "description": "Only invoices of this contact (id from sevdesk_contacts_search).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "from": {
          "description": "First day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "number": {
          "description": "Exact invoice number, e.g. 'RE-1000'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "overdueOnly": {
          "default": false,
          "description": "Only open/partially paid invoices past their due date (Berlin time).",
          "type": "boolean",
        },
        "status": {
          "description": "draft (100), open (200), partially_paid (750) or paid (1000).",
          "enum": [
            "draft",
            "open",
            "partially_paid",
            "paid",
          ],
          "type": "string",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "type": {
          "description": "Invoice type: invoice (RE), advance, partial, final, cancellation, reminder…",
          "enum": [
            "invoice",
            "advance",
            "partial",
            "final",
            "cancellation",
            "reminder",
            "recurring",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_invoices_list",
    "title": "List sevDesk invoices",
  },
