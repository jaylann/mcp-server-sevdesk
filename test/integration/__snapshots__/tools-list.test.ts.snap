      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Order id (not its number), e.g. from sevdesk_orders_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_order_get",
