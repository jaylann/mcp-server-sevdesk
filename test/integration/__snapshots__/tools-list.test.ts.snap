          "type": "boolean",
        },
        "id": {
          "description": "Invoice id (not the invoice number), e.g. from sevdesk_invoices_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "to": {
          "description": "open: unlink all payments of a paid or partially paid document (resetToOpen). draft: turn an open document without payments back into a draft (resetToDraft).",
          "enum": [
