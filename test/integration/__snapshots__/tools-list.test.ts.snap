        },
        "headText": {
          "description": "Intro text above the positions (Kopftext); simple HTML allowed.",
          "maxLength": 10000,
          "type": "string",
        },
        "header": {
          "description": "Document title (Betreff); default "Gutschrift".",
          "maxLength": 250,
          "minLength": 1,
          "type": "string",
        },
        "positions": {
          "description": "Positionen in printed order; prices per priceMode.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "discountPercent": {
                "description": "Rabatt on this position in percent, more than 0 and at most 100.",
                "type": [
                  "string",
                  "number",
                ],
              },
              "name": {
                "description": "Article or service name (Bezeichnung) as printed.",
                "maxLength": 250,
                "minLength": 1,
                "type": "string",
              },
              "partId": {
                "description": "Inventory part (Artikel, see sevdesk_parts_list) to link. Name and price still come from this position; sevDesk does not fill them in.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "quantity": {
                "description": "Menge, greater than 0, up to 4 decimals, e.g. 2 or "1.5".",
                "type": [
                  "string",
                  "number",
                ],
              },
              "taxRate": {
                "description": "Umsatzsteuersatz in percent, e.g. 19, 7 or 0; must be allowed by the tax rule. May be left out only when the rule allows a single rate (e.g. 0 for rule 11).",
                "type": [
                  "string",
                  "number",
                ],
              },
              "text": {
                "description": "Description printed below the name (Positionstext); line breaks allowed.",
                "maxLength": 5000,
                "type": "string",
              },
              "unitId": {
                "description": "Einheit (Unity id, see sevdesk_reference_lookup kind=units); default 1 = Stk.",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "unitPrice": {
                "description": "Einzelpreis per unit in the document currency, net or gross as the document's priceMode says; up to 4 decimals, e.g. "49.90"; negative for a deduction line.",
                "type": [
                  "string",
                  "number",
