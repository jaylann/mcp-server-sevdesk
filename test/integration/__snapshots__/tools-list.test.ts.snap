      "properties": {
        "asOf": {
          "description": "Day of the balances (Stichtag), YYYY-MM-DD; default today (Berlin). With outlookDays it must be today or later (sevDesk only knows today's open items).",
          "type": "string",
        },
        "includeArchived": {
          "default": false,
          "description": "Also list archived accounts (archiviert).",
          "type": "boolean",
        },
        "outlookDays": {
          "description": "Add the expected in- and outflows due within this many days after asOf.",
          "maximum": 365,
          "minimum": 1,
