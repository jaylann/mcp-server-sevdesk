        "id": {
          "description": "sevDesk id of the document (not its number such as RE-1001).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
