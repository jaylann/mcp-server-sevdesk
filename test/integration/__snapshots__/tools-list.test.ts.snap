  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Book a payment on a sevDesk invoice",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Amount received, gross, positive, in the invoice's currency, e.g. "119.00" (at most 2 decimals).",
          "type": [
            "string",
            "number",
          ],
        },
        "checkAccountId": {
          "description": "Check account (Zahlungskonto) the money moved on, from sevdesk_bank_accounts_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "date": {
          "description": "Booking date (Zahlungsdatum), YYYY-MM-DD; defaults to today (Berlin).",
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "id": {
          "description": "Invoice id (not the invoice number), e.g. from sevdesk_invoices_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "paymentType": {
          "description": "payment (default): all of the open amount or a part of it. cash_discount: less than the open amount, the rest is written off as Skonto. bank_fees: less, the rest written off as bank fees (Geldverkehrskosten). other_difference: more or less than the open amount for another reason; the document is settled. reminder_charges: more than the open amount, the extra booked as reminder charges (Mahngebühren).",
          "enum": [
            "payment",
            "cash_discount",
            "bank_fees",
            "other_difference",
            "reminder_charges",
          ],
          "type": "string",
        },
        "transactionId": {
          "description": "Imported bank transaction (Umsatz) to link, from sevdesk_transactions_list (status created, same account). Without it sevDesk creates a new transaction (offline and cash accounts only).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
        "amount",
        "checkAccountId",
      ],
      "type": "object",
    },
    "name": "sevdesk_invoice_book_payment",
    "title": "Book a payment on a sevDesk invoice",
  },
