  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a sevDesk part",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Description (Beschreibung) printed on documents.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "internalComment": {
          "description": "Internal note, not printed.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "name": {
          "description": "Part name (Artikelname) as printed on documents.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "partNumber": {
          "description": "Artikelnummer; must not be used by another part.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "price": {
          "description": "Sales price (Verkaufspreis) in EUR, net or gross per priceType; the other one is computed with the tax rate.",
          "type": [
            "string",
            "number",
          ],
        },
        "pricePurchase": {
          "description": "Purchase price (Einkaufspreis), net, EUR.",
          "type": [
            "string",
            "number",
          ],
        },
        "priceType": {
          "default": "net",
          "description": "Whether price is the net (netto, default) or gross (brutto) price.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "stock": {
          "description": "Stock (Bestand).",
          "type": [
            "string",
            "number",
          ],
        },
        "stockEnabled": {
          "default": false,
          "description": "Track stock (Lagerbestand) for the part.",
          "type": "boolean",
        },
        "taxRate": {
          "description": "Tax rate in percent, default 19.",
          "type": [
            "string",
            "number",
          ],
        },
        "unitId": {
          "default": 1,
          "description": "Unit (Einheit) id, see sevdesk_reference_lookup kind=units (1 = Stk).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "name",
        "partNumber",
      ],
      "type": "object",
    },
    "name": "sevdesk_part_create",
    "title": "Create a sevDesk part",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get a sevDesk part",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Part id, e.g. from sevdesk_parts_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_part_get",
    "title": "Get a sevDesk part",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update a sevDesk part",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "active": {
          "description": "false deactivates the part (inactive), true activates it.",
          "type": "boolean",
        },
        "description": {
          "description": "Description (Beschreibung) printed on documents.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "dryRun": {
          "description": "Preview only: check the action and return exactly what it would do, without changing anything in sevDesk and without asking the user. Defaults to false.",
          "type": "boolean",
        },
        "id": {
          "description": "Part id, e.g. from sevdesk_parts_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "internalComment": {
          "description": "Internal note, not printed.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "name": {
          "description": "Part name (Artikelname) as printed on documents.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "partNumber": {
          "description": "Artikelnummer; must not be used by another part.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "price": {
          "description": "Sales price (Verkaufspreis) in EUR, net or gross per priceType; the other one is computed with the tax rate.",
          "type": [
            "string",
            "number",
          ],
        },
        "pricePurchase": {
          "description": "Purchase price (Einkaufspreis), net, EUR.",
          "type": [
            "string",
            "number",
          ],
        },
        "priceType": {
          "default": "net",
          "description": "Whether price is the net (netto, default) or gross (brutto) price.",
          "enum": [
            "net",
            "gross",
          ],
          "type": "string",
        },
        "stock": {
          "description": "Stock (Bestand).",
          "type": [
            "string",
            "number",
          ],
        },
        "stockEnabled": {
          "description": "Track stock (Lagerbestand) for the part.",
          "type": "boolean",
        },
        "taxRate": {
          "description": "Tax rate in percent.",
          "type": [
            "string",
            "number",
          ],
        },
        "unitId": {
          "description": "Unit (Einheit) id, see sevdesk_reference_lookup kind=units (1 = Stk).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_part_update",
    "title": "Update a sevDesk part",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List sevDesk parts",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "name": {
          "description": "Part name.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "partNumber": {
          "description": "Part number (Artikelnummer), e.g. 'ART-001'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_parts_list",
    "title": "List sevDesk parts",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Payables aging",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "description": "Reference day (Stichtag), YYYY-MM-DD, today or later; default today (Berlin). sevDesk only knows today's open items, so a past day is refused; a later day ages today's open items as of that day.",
          "type": "string",
        },
        "top": {
          "default": 10,
          "description": "How many of the largest parties to list per currency.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_payables_aging",
    "title": "Payables aging",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Receivables aging",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "description": "Reference day (Stichtag), YYYY-MM-DD, today or later; default today (Berlin). sevDesk only knows today's open items, so a past day is refused; a later day ages today's open items as of that day.",
          "type": "string",
        },
        "top": {
          "default": 10,
          "description": "How many of the largest parties to list per currency.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_receivables_aging",
    "title": "Receivables aging",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Summarize sevDesk records",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "description": "Transactions only: payment account (Zahlungskonto) id.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "contactId": {
          "description": "Customer (invoices, credit notes) or supplier (vouchers) contact id.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "from": {
          "description": "First day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "groupBy": {
          "default": "none",
          "description": "none, month, quarter, status, contact (customer/supplier; not for transactions) or account (transactions only).",
          "enum": [
            "none",
            "month",
            "quarter",
            "status",
            "contact",
            "account",
          ],
          "type": "string",
        },
        "invoiceType": {
          "description": "Invoices only: invoice (RE), advance (AR), partial (TR), final (ER), cancellation (SR), reminder (MA) or recurring (WKR template); reminders and templates count only when asked for here.",
          "enum": [
            "invoice",
            "advance",
            "partial",
            "final",
            "cancellation",
            "reminder",
            "recurring",
          ],
          "type": "string",
        },
        "kind": {
          "description": "Vouchers only: expense (Ausgabe) or revenue (Einnahme).",
          "enum": [
            "expense",
            "revenue",
          ],
          "type": "string",
        },
        "maxGroups": {
          "default": 50,
          "description": "Most groups to return; the rest are counted in groupsOmitted.",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "status": {
          "description": "Invoices/credit notes: draft, open, partially_paid, paid. Vouchers: draft, open, transferred, partially_paid, paid. Transactions: created, linked, private, auto_booked, booked.",
          "enum": [
            "draft",
            "open",
            "partially_paid",
            "paid",
            "transferred",
            "created",
            "linked",
            "private",
            "auto_booked",
            "booked",
          ],
          "type": "string",
        },
        "subject": {
          "description": "invoices, credit_notes, vouchers or transactions (bank transactions).",
          "enum": [
            "invoices",
            "credit_notes",
            "vouchers",
            "transactions",
          ],
          "type": "string",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
      },
      "required": [
        "subject",
      ],
      "type": "object",
    },
    "name": "sevdesk_records_summarize",
    "title": "Summarize sevDesk records",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Look up sevDesk ids and codes",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "accountNumber": {
          "description": "receipt_guidance only: exact account number in the chart of accounts.",
          "pattern": "^\\d{1,12}$",
          "type": "string",
        },
        "kind": {
          "description": "Which list to return.",
          "enum": [
            "tax_rules",
            "contact_categories",
            "status_codes",
            "document_types",
            "users",
            "countries",
            "units",
            "payment_methods",
            "receipt_guidance",
          ],
          "type": "string",
        },
        "limit": {
          "description": "receipt_guidance only: page size, 1–100 (default 25).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "description": "receipt_guidance only: entries to skip; pass the previous nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "query": {
          "description": "Case-insensitive substring filter on names, codes and ids, e.g. 'reverse'.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "receiptType": {
          "description": "receipt_guidance only: accounts for expense or revenue receipts.",
          "enum": [
            "expense",
            "revenue",
          ],
          "type": "string",
        },
        "taxRuleId": {
          "description": "receipt_guidance only: accounts that allow this tax rule id.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "kind",
      ],
      "type": "object",
    },
    "name": "sevdesk_reference_lookup",
    "title": "Look up sevDesk ids and codes",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List sevDesk bank transactions",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "checkAccountId": {
          "description": "Payment account (Zahlungskonto) id.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "dateField": {
          "default": "value",
          "description": "Date that from/to apply to: value (Wertstellung, default; filtered here) or entry (the second date, see entryDate; sevDesk filters it itself).",
          "enum": [
            "value",
            "entry",
          ],
          "type": "string",
        },
        "direction": {
          "description": "in = incoming (positive), out = outgoing (negative).",
          "enum": [
            "in",
            "out",
          ],
          "type": "string",
        },
        "from": {
          "description": "First day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "status": {
          "description": "Statuses to include, e.g. ['created'] for unbooked transactions.",
          "items": {
            "enum": [
              "created",
              "linked",
              "private",
              "auto_booked",
              "booked",
            ],
            "type": "string",
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_transactions_list",
    "title": "List sevDesk bank transactions",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get a sevDesk voucher",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Voucher id, e.g. from sevdesk_vouchers_list.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_voucher_get",
    "title": "Get a sevDesk voucher",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List sevDesk vouchers",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Part of the Belegnummer or description, e.g. an invoice number.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "from": {
          "description": "First day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "kind": {
          "description": "expense (Ausgabe, creditDebit C) or revenue (Einnahme, creditDebit D).",
          "enum": [
            "expense",
            "revenue",
          ],
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1–100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Rows to skip, for paging: pass the previous result's nextOffset.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "status": {
          "description": "Voucher status by name.",
          "enum": [
            "draft",
            "open",
            "transferred",
            "partially_paid",
            "paid",
          ],
          "type": "string",
        },
        "supplierId": {
          "description": "Contact id of the supplier (Lieferant) or customer.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "supplierName": {
          "description": "Part of the supplier name, for vouchers without a contact too.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "to": {
          "description": "Last day to include, YYYY-MM-DD (Berlin time).",
          "type": "string",
        },
        "type": {
          "description": "normal (VOU) or recurring (RV).",
          "enum": [
            "normal",
            "recurring",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sevdesk_vouchers_list",
    "title": "List sevDesk vouchers",
  },
]
`;

exports[`tools/list > SEVDESK_OUTPUT_DIR set (adds the file-writing save tool) 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Save a document file to disk",
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "document": {
          "description": "Which file: invoice_pdf, credit_note_pdf, order_pdf, or invoice_xml (e-invoice XML).",
          "enum": [
            "invoice_pdf",
            "credit_note_pdf",
            "order_pdf",
            "invoice_xml",
          ],
          "type": "string",
        },
        "id": {
          "description": "sevDesk id of the document (not its number such as RE-1001).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "document",
        "id",
      ],
      "type": "object",
    },
    "name": "sevdesk_document_save",
    "title": "Save a document file to disk",
  },
]
`;

exports[`tools/list > default configuration (read tier, default toolsets) 1`] = `
[
  {
