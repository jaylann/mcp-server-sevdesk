        "subjects": {
          "default": [
            "contacts",
            "invoices",
            "credit_notes",
            "orders",
            "vouchers",
            "transactions",
          ],
          "description": "Which records to check; default all.",
          "items": {
            "enum": [
              "contacts",
              "invoices",
              "credit_notes",
              "orders",
              "vouchers",
              "transactions",
            ],
            "type": "string",
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "since",
      ],
      "type": "object",
    },
    "name": "sevdesk_changed_since",
    "title": "Changes since",
